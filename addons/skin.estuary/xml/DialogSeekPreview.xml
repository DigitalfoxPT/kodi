<?xml version="1.0" encoding="UTF-8"?>
<window>
	<visible>Window.IsActive(fullscreenvideo) + !VideoPlayer.Content(LiveTV) + !String.IsEmpty(Player.SeekPreview)</visible>
	<depth>DepthOSD+</depth>
	<zorder>1</zorder>
	<controls>
		<control type="group">
			<visible>!Window.IsVisible(videoosd)</visible>
			<centerleft>50%</centerleft>
			<top>75</top>
			<width>500</width>
			<height>281</height>
			<animation effect="fade" time="150">VisibleChange</animation>
			<control type="image">
				<left>-6</left>
				<top>-6</top>
				<width>512</width>
				<height>293</height>
				<texture border="10" colordiffuse="CC000000">colors/white.png</texture>
			</control>
			<control type="image">
				<width>500</width>
				<height>281</height>
				<aspectratio align="center" aligny="center">keep</aspectratio>
				<texture background="true">$INFO[Player.SeekPreview]</texture>
			</control>
		</control>
		<control type="group">
			<visible>Window.IsVisible(videoosd)</visible>
			<centerleft>50%</centerleft>
			<bottom>210</bottom>
			<width>500</width>
			<height>281</height>
			<animation effect="fade" time="150">VisibleChange</animation>
			<control type="image">
				<left>-6</left>
				<top>-6</top>
				<width>512</width>
				<height>293</height>
				<texture border="10" colordiffuse="CC000000">colors/white.png</texture>
			</control>
			<control type="image">
				<width>500</width>
				<height>281</height>
				<aspectratio align="center" aligny="center">keep</aspectratio>
				<texture background="true">$INFO[Player.SeekPreview]</texture>
			</control>
		</control>
	</controls>
</window>
