<Window
    x:Class="KodiSeekPreviewGenerator.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Kodi Seek Preview Generator">
    <Grid x:Name="RootLayout" Padding="24" Background="#202020">
        <StackPanel Spacing="12">
            <TextBlock Text="Kodi Seek Preview Generator" FontSize="28" />
            <TextBlock Text="Cria um ficheiro .bif por vídeo, de 10 em 10 segundos, incluindo todas as subpastas."
                       TextWrapping="Wrap" />
            <TextBlock Text="Pasta principal dos vídeos" />
            <TextBox x:Name="FolderPathBox"
                     PlaceholderText="Escolha a pasta Shows ou outra pasta principal"
                     IsReadOnly="True" />
            <StackPanel Orientation="Horizontal" Spacing="8">
                <Button x:Name="BrowseButton" Content="Escolher pasta" />
                <Button x:Name="GenerateButton" Content="Analisar e gerar previews" />
                <Button x:Name="CancelButton" Content="Cancelar" IsEnabled="False" />
            </StackPanel>
            <ProgressBar x:Name="GenerationProgressBar" Minimum="0" Maximum="1" Value="0" />
            <TextBlock x:Name="StatusTitleTextBlock" Text="Pronto" FontSize="18" />
            <TextBlock x:Name="StatusMessageTextBlock"
                       Text="Selecione a pasta e inicie a análise."
                       TextWrapping="Wrap" />
            <ListView x:Name="LogList" Height="320" SelectionMode="None" />
        </StackPanel>
    </Grid>
</Window>
